{
  "name": "tax-workpaper-web",
  "version": "1.0.0",
  "private": true,
  "description": "React + Tailwind front end for the web-native tax workpaper (served by the FastAPI app).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p web --noEmit",
    "build:js": "esbuild web/src/main.tsx --bundle --minify --sourcemap --format=esm --target=es2020 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=static/app/main.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i web/styles.css -o static/app/app.css --minify",
    "build": "npm run typecheck && npm run build:js && npm run build:css",
    "watch:js": "npm run build:js -- --watch",
    "watch:css": "npm run build:css -- --watch"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  }
}
